{
  "name": "claude-cast",
  "version": "0.1.0",
  "description": "Convert Claude Code JSONL logs into terminal screencasts",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-cast": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts examples/demo.jsonl -o examples/demo.cast",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["claude", "screencast", "asciicast", "terminal"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
